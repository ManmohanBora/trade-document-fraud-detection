# ── Application ──────────────────────────────────────────────────────────
APP_NAME="Trade Document Fraud Detection Pipeline"
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=fraud_pipeline
DB_PASSWORD=changeme
DB_NAME=trade_fraud_audit
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=5

# ── OCR ──────────────────────────────────────────────────────────────────
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_PREPROCESSING_ENABLED=true

# ── Image Analytics ──────────────────────────────────────────────────────
IMG_YOLO_MODEL_PATH=models/yolo/best.pt
IMG_RESNET_MODEL_PATH=models/resnet/stamp_classifier.pth
IMG_CONFIDENCE_THRESHOLD=0.65
IMG_MANIPULATION_SENSITIVITY=0.7

# ── NLP / Document Understanding ────────────────────────────────────────
NLP_LAYOUTLM_MODEL=microsoft/layoutlmv3-base
NLP_MAX_SEQUENCE_LENGTH=512
NLP_BATCH_SIZE=8
NLP_DEVICE=cpu

# ── Risk Assessment ─────────────────────────────────────────────────────
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=40
RISK_VISUAL_WEIGHT=0.4
RISK_TEXTUAL_WEIGHT=0.4
RISK_LAYOUT_WEIGHT=0.2
